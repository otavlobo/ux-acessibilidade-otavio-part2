/* Configurações Globais e Resets */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #0c1327;
    color: #1A1A1A;
    line-height: 1.6;
    padding: 16px;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
}

/* Background Canvas 3D e Overlay */
#bg-3d {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2;
    pointer-events: none;
}

.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: radial-gradient(circle at 50% 30%, rgba(12, 19, 39, 0.2) 0%, rgba(12, 19, 39, 0.75) 100%);
    z-index: -1;
    pointer-events: none;
}

/* Cabeçalho */
.cabecalho {
    background: rgba(0, 64, 133, 0.85);
    color: #FFFFFF;
    text-align: center;
    padding: 28px 20px;
    border-radius: 16px;
    margin-bottom: 24px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.cabecalho h1 {
    font-size: 2.4rem;
    margin-bottom: 8px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.cabecalho p {
    font-size: 1.3rem;
    opacity: 0.95;
}

/* Conteúdo e Cartões estilo Glassmorphism */
.conteudo {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
}

.cartao-dica {
    background: rgba(255, 255, 255, 0.92);
    border: 2px solid rgba(0, 64, 133, 0.5);
    border-radius: 16px;
    padding: 24px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cartao-dica:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}

.icone {
    font-size: 3.2rem;
    text-align: center;
    margin-bottom: 12px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
}

.cartao-dica h2 {
    font-size: 1.8rem;
    color: #004085;
    margin-bottom: 16px;
    border-bottom: 2px solid #E0E0E0;
    padding-bottom: 8px;
}

.cartao-dica ul {
    list-style-type: none;
}

.cartao-dica li {
    font-size: 1.3rem;
    margin-bottom: 12px;
    padding-left: 8px;
    color: #222222;
}

.cartao-dica li strong {
    color: #003366;
}

/* Rodapé e Botão de Emergência */
.rodape {
    max-width: 800px;
    margin: 32px auto 16px auto;
}

.botao-emergencia {
    width: 100%;
    background: linear-gradient(135deg, #D9534F 0%, #C9302C 100%);
    color: #FFFFFF;
    font-size: 1.5rem;
    font-weight: bold;
    border: none;
    border-radius: 16px;
    padding: 20px;
    cursor: pointer;
    text-align: center;
    box-shadow: 0 6px 20px rgba(217, 83, 79, 0.4);
    transition: all 0.3s ease;
}

.botao-emergencia:hover {
    background: linear-gradient(135deg, #C9302C 0%, #B02420 100%);
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(217, 83, 79, 0.6);
}

.botao-emergencia:active {
    transform: scale(0.99);
}
